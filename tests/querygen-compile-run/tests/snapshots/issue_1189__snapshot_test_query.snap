---
subscription DoorActivitySubscription($doorIds: [UUID!]!, $since: DateTime!) {
  doorActivity(doorUids: $doorIds, receivedSince: $since) {
    occurredAt
    receivedAt
    __typename
    ... {
      __typename
      ... on BadgeSwipeEvent {
        badgeSwipe {
          uid
          outcome
        }
      }
    }
  }
}
